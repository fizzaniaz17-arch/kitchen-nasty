              1,
              50
            ]
          },
          {
            "in": "query",
            "name": "time",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
            },
            "example": "19:00",
            "description": "The API guide shows a time-specific lookup. The current handler ignores this parameter and returns the daily slots. Malformed-value handling is unspecified.",
