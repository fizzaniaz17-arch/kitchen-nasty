      "tableId": {
        "in": "path",
        "name": "tableId",
        "required": true,
        "schema": {
          "type": "string"
        }
      },
      "page": {
        "in": "query",
        "name": "page",
        "schema": {
          "type": "string"
        },
        "description": "parseInt; defaults to 1 and clamps to at least 1.",
        "x-clamp-boundaries": [
          1
        ]
      },
      "limit": {
        "in": "query",
        "name": "limit",
        "schema": {
          "type": "string"
        },
        "description": "parseInt; defaults to 20 and clamps to 1..50.",
        "x-clamp-boundaries": [
          1,
          50
        ]
      }
    }
