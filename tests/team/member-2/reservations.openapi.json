{
  "openapi": "3.0.3",
  "info": {
    "title": "KitchenAsty reservation workflow",
    "version": "1.0.0",
    "description": "Scoped description of current HTTP behavior; cross-record business rules are documented separately."
  },
  "servers": [
    {
      "url": "/api"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateReservation": {
        "type": "object",
        "required": [
          "locationId",
          "date",
          "time",
          "partySize"
        ],
        "properties": {
          "locationId": {
            "type": "string",
            "minLength": 1
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "x-business-scenarios": [
              {
                "name": "impossible-calendar-date",
                "value": "2099-02-30",
                "valid": false
              }
            ],
            "x-minimum-days-from-today": 0
          },
          "time": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$",
            "x-business-scenarios": [
              {
                "name": "clock-below-min",
                "value": "-1:59",
                "valid": false
              },
              {
                "name": "clock-min",
                "value": "00:00",
                "valid": true
              },
              {
                "name": "clock-above-min",
                "value": "00:01",
                "valid": true
              },
              {
                "name": "clock-below-max",
                "value": "23:58",
                "valid": true
              },
              {
                "name": "clock-max",
                "value": "23:59",
                "valid": true
              },
              {
                "name": "clock-above-max",
                "value": "24:00",
                "valid": false
              },
              {
                "name": "invalid-hour-minute",
                "value": "99:99",
                "valid": false
              },
              {
                "name": "invalid-minute",
                "value": "19:99",
                "valid": false
              }
            ]
          },
          "partySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "comment": {
            "type": "string"
          }
        },
        "x-object-samples": [
          {
            "name": "empty-object",
            "value": {},
            "valid": false
          },
          {
            "name": "extra-field",
            "extendValidBody": true,
            "value": {
              "status": "SEATED"
            },
            "valid": true
          }
        ]
      },
      "UpdateReservation": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "SEATED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "tableId": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
            "x-business-scenarios": [
              {
                "name": "impossible-calendar-date",
                "value": "2099-02-30",
                "valid": false
              }
            ]
          },
          "time": {
            "type": "string",
            "pattern": "^[0-9]{2}:[0-9]{2}$",
            "x-business-scenarios": [
              {
                "name": "clock-below-min",
                "value": "-1:59",
                "valid": false
              },
              {
                "name": "clock-min",
                "value": "00:00",
                "valid": true
              },
              {
                "name": "clock-above-min",
                "value": "00:01",
                "valid": true
              },
              {
                "name": "clock-below-max",
                "value": "23:58",
                "valid": true
              },
              {
                "name": "clock-max",
                "value": "23:59",
                "valid": true
              },
              {
                "name": "clock-above-max",
                "value": "24:00",
                "valid": false
              },
              {
                "name": "invalid-hour-minute",
                "value": "99:99",
                "valid": false
              },
              {
                "name": "invalid-minute",
                "value": "19:99",
                "valid": false
              }
            ]
          },
          "partySize": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "comment": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "CreateTable": {
        "type": "object",
        "required": [
          "name",
          "capacity"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "isActive": {
            "type": "boolean",
            "default": true
          }
        }
      },
      "UpdateTable": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "capacity": {
            "type": "integer",
            "minimum": 1
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
