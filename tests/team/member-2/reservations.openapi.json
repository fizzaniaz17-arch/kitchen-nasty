        "type": "object",
        "required": [
          "id",
          "customerId",
          "locationId",
          "date",
          "time",
          "partySize",
          "status",
          "tableId",
          "comment",
          "location",
          "table"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "customerId": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "tableId": {
            "type": "string",
            "nullable": true
          },
          "date": {
            "type": "string",
            "format": "date-time"
          },
          "time": {
            "type": "string"
          },
          "partySize": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "PENDING",
              "CONFIRMED",
              "SEATED",
              "COMPLETED",
              "CANCELLED"
            ]
          },
          "comment": {
            "type": "string",
            "nullable": true
          },
          "location": {
            "type": "object",
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          },
          "table": {
            "type": "object",
            "required": [
              "id",
              "name",
              "capacity"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "capacity": {
                "type": "integer"
              }
            },
            "nullable": true
          }
        }
      },
      "Table": {
        "type": "object",
        "required": [
          "id",
          "locationId",
          "name",
          "capacity",
          "isActive"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "locationId": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "capacity": {
            "type": "integer"
          },
          "isActive": {
            "type": "boolean"
          }
        }
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "Availability": {
        "type": "object",
        "required": [
          "slots",
          "totalTables"
        ],
        "properties": {
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "time",
                "available"
              ],
              "properties": {
                "time": {
                  "type": "string"
                },
                "available": {
                  "type": "boolean"
                }
              }
            }
          },
          "totalTables": {
            "type": "integer"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "success",
          "error"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "code",
                    "path",
                    "message"
                  ],
                  "properties": {
                    "code": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    },
                    "path": {
                      "type": "array",
                      "items": {
                        "oneOf": [
                          {
                            "type": "integer"
                          },
                          {
                            "type": "string"
                          }
                        ]
                      }
                    }
                  }
                },
                "minItems": 1
              }
            ]
          }
        }
      }
    },
    "parameters": {
      "id": {
        "in": "path",
        "name": "id",
        "required": true,
        "schema": {
          "type": "string"
        }
