{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.member1.stryker.config.ts",
    "related": false
  },
  "mutate": [
    "packages/server/src/controllers/reservation.controller.ts",
    "packages/server/src/controllers/table.controller.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "jsonReporter": { "fileName": "reports/mutation/final-56-tests/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation/final-56-tests/index.html" },
  "thresholds": { "high": 80, "low": 60, "break": 60 },
  "concurrency": 2,
  "tempDirName": ".stryker-tmp/member-1",
  "cleanTempDir": true
}
